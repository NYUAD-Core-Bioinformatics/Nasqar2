// CI-Build-from-Image: a quick build for changes to application code only.
//
// The applications, the landing page and the nginx and supervisord
// configuration are copied over the image in the internal registry, so the
// conda environment, the R packages and the example data are not rebuilt.
// Use Nasqar-CI (the full build) after any change to environment.yaml or to
// the package or data steps of the Dockerfile, and from time to time anyway:
// each quick build adds about 18 layers to the image it starts from.
//
// Site-specific values are not kept in this file. Define them once as
// environment variables in Jenkins (Manage Jenkins > System > Global
// properties > Environment variables); the first stage stops the build and
// lists any that are missing, empty or still set to FILL_IN.
//
//   NASQAR_BUILD_HOST                  name of the build host the container is reached on, e.g. build.example.org
//   NASQAR_REGISTRY_HOST               internal registry, e.g. registry.example.org
//   NASQAR_REGISTRY_NAMESPACE          repository namespace on that registry, e.g. mygroup

pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    ws('/workspace/jobs')
  }

  environment {
    REPO_URL    = 'https://github.com/NYUAD-Core-Bioinformatics/Nasqar2'
    REPO_BRANCH = 'main'
    APP_IMAGE   = 'nasqarall'
    APP_NAME    = 'nasqar'
    APP_PORT    = '8181'
    APP_HOST    = "${env.NASQAR_BUILD_HOST}"
    BASE_IMAGE  = "${env.NASQAR_REGISTRY_HOST}/${env.NASQAR_REGISTRY_NAMESPACE}/nasqarall:latest"
  }

  stages {

    stage('Check configuration') {
      steps {
        sh '''
          missing=""
          for name in NASQAR_BUILD_HOST NASQAR_REGISTRY_HOST NASQAR_REGISTRY_NAMESPACE; do
            value=$(printenv "$name" || true)
            case "$value" in
              ''|FILL_IN) missing="$missing $name" ;;
            esac
          done
          if [ -n "$missing" ]; then
            echo "Not set, empty or still FILL_IN in Jenkins (Manage Jenkins > System > Global properties > Environment variables):$missing"
            exit 1
          fi
        '''
      }
    }

    stage('Cleanup Workspace') {
      steps {
        echo "=== Cleaning /workspace/jobs to avoid @2 directories ==="
        deleteDir()
        // The previous container keeps serving until the new image is built.
        sh '''
          docker image prune -f || true
          docker builder prune -f --filter until=336h || true
        '''
      }
    }

    stage('Build Docker Image') {
      steps {
        sh '''#!/bin/bash
          set -eux
          echo "=== Cloning Nasqar2 repo ==="
          rm -rf Nasqar2 || true
          git clone --depth 1 --branch "${REPO_BRANCH}" "${REPO_URL}" Nasqar2

          cd Nasqar2
          git log -1 --oneline

          echo "=== Pulling the base image ==="
          docker pull "${BASE_IMAGE}"

          # The base image must have been built from the same conda
          # environment; the full build keeps a copy of environment.yaml in it.
          if ! docker run --rm --entrypoint cat "${BASE_IMAGE}" /srv/shiny-server/environment.yaml | diff -q - environment.yaml; then
            echo "ERROR: environment.yaml differs from the one in ${BASE_IMAGE}; run Nasqar-CI (the full build)."
            exit 1
          fi

          # Docker allows 127 layers and every quick build adds about 18.
          LAYERS=$(docker image inspect --format '{{len .RootFS.Layers}}' "${BASE_IMAGE}")
          echo "Base image has ${LAYERS} layers."
          if [ "${LAYERS}" -gt 105 ]; then
            echo "ERROR: ${BASE_IMAGE} has too many layers for another quick build; run Nasqar-CI (the full build)."
            exit 1
          fi

          # Derive the code-only Dockerfile from the repository's Dockerfile so
          # the two cannot drift apart: the UI stage as it is, then everything
          # from the first application COPY to the end, on top of the base
          # image. The final recursive chmod is left out; it would copy every
          # file under /srv/shiny-server into a new layer, and files from a git
          # clone are already world-readable.
          echo "=== Generating Dockerfile.code-only ==="
          awk -v base="${BASE_IMAGE}" '
            BEGIN { bs = sprintf("%c", 92) }
            /^FROM / { n++; if (n == 2) { print "FROM " base; skip = 1; next } }
            skip && /^COPY [A-Za-z0-9_]+ [/]srv[/]shiny-server[/][A-Za-z0-9_]+$/ { skip = 0 }
            !skip && /^RUN chmod -R / { drop = 1 }
            drop { if (substr($0, length($0)) != bs) drop = 0; next }
            !skip { print }
          ' Dockerfile > Dockerfile.code-only
          cat Dockerfile.code-only

          [ "$(grep -c "^FROM " Dockerfile.code-only)" = "2" ]
          grep -q "^COPY [A-Za-z0-9_]* /srv/shiny-server/" Dockerfile.code-only
          grep -q "^COPY --from=ui-builder " Dockerfile.code-only
          grep -q "^CMD " Dockerfile.code-only
        '''
        retry(3) {
          sh '''#!/bin/bash
            set -eux
            cd Nasqar2
            echo "=== Building image ==="
            docker build -f Dockerfile.code-only -t "${APP_IMAGE}:latest" .
          '''
        }
      }
    }

    stage('Run Docker Container') {
      steps {
        sh '''#!/bin/bash
          set -eux
          echo "=== Replacing container ==="
          docker rm -f "${APP_NAME}" || true
          docker run -d --name "${APP_NAME}" -p "${APP_PORT}:80" "${APP_IMAGE}:latest"
          docker ps -a | grep "${APP_NAME}"
          docker images
        '''
      }
    }

    stage('Health Check URLs') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail

          BASE="http://${APP_HOST}:${APP_PORT}"
          URLS=(
            "${BASE}/"
            "${BASE}/GeneCountMerger/"
            "${BASE}/mergeFPKMs/"
            "${BASE}/DEBrowser/"
            "${BASE}/deseq2shiny/"
            "${BASE}/tsar_nasqar/"
            "${BASE}/ClusterProfShinyGSEA/"
            "${BASE}/ClusterProfShinyORA/"
            "${BASE}/DADA2Shiny/"
            "${BASE}/animalcules/"
            "${BASE}/ATACseqQCShniy/"
            "${BASE}/SeuratV5Shiny/"
            "${BASE}/monocle3/"
            "${BASE}/VariantAnnotationShiny/"
          )

          # The applications load their packages at startup, some for over a
          # minute, so each URL is retried for up to 5 minutes.
          failed=0
          for url in "${URLS[@]}"; do
            echo "=== Checking $url ==="
            code=000
            for attempt in $(seq 1 30); do
              code=$(curl -s -o /dev/null --max-time 20 -w "%{http_code}" "$url" || true)
              [ "$code" = "200" ] && break
              sleep 10
            done
            if [ "$code" = "200" ]; then
              echo "SUCCESS: $url returned 200 OK"
            else
              echo "ERROR: $url returned $code"
              failed=1
            fi
          done

          echo "=== supervisord programs ==="
          docker exec "${APP_NAME}" supervisorctl status || failed=1

          exit $failed
        '''
      }
    }

    stage('Validate R Packages') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          echo "=== Validating required R packages inside container ==="

          docker exec "${APP_NAME}" Rscript -e 'pkgs <- c("smplot2", "GOplot", "wordcloud2", "genesorteR", "dqshiny", "BPCells", "SeuratWrappers", "monocle3", "shinythemes", "VariantAnnotation", "TxDb.Hsapiens.UCSC.hg19.knownGene", "TxDb.Hsapiens.UCSC.hg38.knownGene", "org.Hs.eg.db", "BSgenome.Hsapiens.UCSC.hg19", "BSgenome.Hsapiens.UCSC.hg38", "SNPlocs.Hsapiens.dbSNP144.GRCh37", "SNPlocs.Hsapiens.dbSNP144.GRCh38"); ok <- vapply(pkgs, requireNamespace, logical(1), quietly = TRUE); for (p in pkgs) cat(if (ok[[p]]) "OK:" else "FAILED:", p, fill = TRUE); if (!all(ok)) quit(status = 1)'
        '''
      }
    }

    stage('Validate App Data') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          echo "=== Validating example data and references inside container ==="

          docker exec "${APP_NAME}" bash -c '
            status=0
            for d in \
              deseq2shiny/src/www/exampleData \
              dada2Shiny/src/www/exampleData \
              ClusterProfShinyORA/src/www/exampleData \
              ClusterProfShinyGSEA/src/www/exampleData \
              tsar_nasqar/src/www/exampleData \
              mergeFPKMs/src/www/exampleData \
              ATACseqQCShniy/src/www/exampleData; do
              if [ -n "$(ls -A "/srv/shiny-server/$d" 2>/dev/null)" ]; then
                echo "OK: $d"
              else
                echo "FAILED: $d is missing or empty"; status=1
              fi
            done
            for f in \
              dada2Shiny/src/www/taxonomy/silva_nr99_v138.1_train_set.fa.gz \
              dada2Shiny/src/www/taxonomy/silva_species_assignment_v138.1.fa.gz; do
              if [ -s "/srv/shiny-server/$f" ]; then
                echo "OK: $f"
              else
                echo "FAILED: $f is missing or empty"; status=1
              fi
            done
            exit $status'
        '''
      }
    }

  }

  post {
    always {
      echo "Pipeline completed (code-only image build + Docker run + health checks)."
    }
    failure {
      echo "❌ Build or checks failed — investigate logs."
      sh '''
        docker exec "${APP_NAME}" supervisorctl status || true
        docker logs --tail 200 "${APP_NAME}" || true
      '''
    }
    success {
      echo "✅ All health checks passed successfully!"
    }
  }
}
