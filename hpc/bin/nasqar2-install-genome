#!/usr/bin/env bash
# Install a Variant Annotation reference genome into the private R library of
# a NASQAR2 Slurm installation. Run it on a login node (compute nodes usually
# have no internet access); the library is the one every job mounts, so the
# genome is available in this and all later jobs.
#
#   nasqar2-install-genome mm39            # a genome from the app's catalog
#   nasqar2-install-genome --list          # show the catalog
#   nasqar2-install-genome BSgenome.Mmusculus.UCSC.mm39 org.Mm.eg.db   # explicit packages
#
# Uses the same NASQAR2_HOME / NASQAR2_SIF / NASQAR2_R_LIBRARY /
# NASQAR2_SINGULARITY_MODULE settings as nasqar2.sbatch.

set -euo pipefail

if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

nasqar2_home="${NASQAR2_HOME:-${SCRATCH:-$HOME}/nasqar2}"
sif="${NASQAR2_SIF:-$nasqar2_home/images/nasqar2.sif}"
r_library="${NASQAR2_R_LIBRARY:-$nasqar2_home/r-library/R-4.3}"
[[ -f "$sif" ]] || { echo "NASQAR2 image not found: $sif (set NASQAR2_HOME or NASQAR2_SIF)" >&2; exit 1; }
mkdir -p "$r_library"

if command -v module >/dev/null 2>&1 && ! command -v singularity >/dev/null 2>&1; then
    module load "${NASQAR2_SINGULARITY_MODULE:-singularity}"
fi

in_container() {
    singularity exec --cleanenv \
        --bind "$r_library:/runtime/R/library" \
        --env R_LIBS_USER=/runtime/R/library \
        "$sif" /opt/conda/envs/merged_env/bin/Rscript -e "$1"
}
catalog='source("/srv/shiny-server/variantAnnotationShiny/src/analysis-helpers.R")'

if [[ "$1" == "--list" ]]; then
    in_container "$catalog; for (r in genome_resources()) cat(sprintf('%-10s %s\n', r\$key, r\$label))"
    exit 0
fi

# A single catalog key expands to its packages; anything else is taken as
# package names.
packages=("$@")
if [[ $# -eq 1 && "$1" != *.* ]]; then
    mapfile -t packages < <(in_container "$catalog; r <- genome_resources()[['$1']]; if (is.null(r)) quit(status = 2); cat(r\$bsgenome, r\$txdb, r\$orgdb, sep = '\n')") ||
        { echo "Unknown genome '$1'; see --list" >&2; exit 2; }
fi

quoted=$(printf '"%s", ' "${packages[@]}"); quoted="${quoted%, }"
echo "Installing into $r_library: ${packages[*]}"
# BSgenome tarballs reach 1 GB; R's default 60 s download limit would abort them.
in_container "options(timeout = 7200); BiocManager::install(c($quoted), lib = '/runtime/R/library', update = FALSE, ask = FALSE)"
echo "Done. The genome is available in this and every later NASQAR2 job."
